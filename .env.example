# --- Authentication ---------------------------------------------------------
# X requires a logged-in session to view most content. Choose one of:
#
# Option 1: Interactive login (recommended)
#   Run: uv run x-mcp-server --login
#   This opens a browser where you sign in manually. Cookies are saved to
#   X_USER_DATA_DIR and reused on all future runs.
#
# Option 2: Manual session cookies
#   Set X_AUTH_TOKEN and X_CSRF_TOKEN below.
#   Get them by: log in to x.com, open DevTools > Application > Cookies >
#   https://x.com, and copy auth_token and ct0 values.
#
X_AUTH_TOKEN=
X_CSRF_TOKEN=

# Optional credentials for the fragile automated DOM login (X_USERNAME/X_PASSWORD).
# Leave blank and use --login instead; automated login does not survive 2FA / email.
X_USERNAME=
X_PASSWORD=

# --- Browser ----------------------------------------------------------------
# Run the browser headless (true) or visible (false). Use false for the first
# interactive login so you can solve any challenge.
X_HEADLESS=true

# Persistent browser profile directory (stores cookies between runs).
X_USER_DATA_DIR=~/.x-mcp/profile

# Browser channel for Patchright stealth. "chrome" is most stealthy and needs
# a real Chrome install; "chromium" falls back to the bundled browser.
X_BROWSER_CHANNEL=chrome

# Per-navigation timeout in milliseconds.
X_NAV_TIMEOUT_MS=30000

# Retries for navigations that fail with a transient network error
# (ERR_NETWORK_CHANGED, connection resets, DNS hiccups). Uses exponential backoff.
X_NAV_RETRIES=3

# How long the interactive `login` tool waits for you to finish signing in (ms).
X_LOGIN_TIMEOUT_MS=180000

# --- Optional Xquik search --------------------------------------------------
# Route only search_tweets through Xquik. Other tools continue using the browser.
XQUIK_API_KEY=

# --- Logging ----------------------------------------------------------------
X_LOG_LEVEL=INFO
